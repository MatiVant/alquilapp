# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2 / S3 compatible storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=alquilapp-documents
R2_PUBLIC_URL=

# Migración inicial (usar solo temporalmente y cambiar después)
MIGRATION_TOKEN=crea-un-token-largo-y-aleatorio

# Auth
AUTH_SECRET=generar-con-openssl-rand-hex-32
AUTH_INITIAL_USERNAME=studioinmobiliaria
AUTH_INITIAL_PASSWORD=123123123
